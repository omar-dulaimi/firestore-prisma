{
  "name": "firestore-prisma",
  "version": "0.0.4",
  "description": "Convert Firestore data into a Prisma schema",
  "repository": "https://github.com/omar-dulaimi/firestore-prisma",
  "bin": {
    "firestore-prisma": "lib/bin/index.js"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "debug": "npm run build && node lib/bin -f sample-firestore.json",
    "clean": "rm -rf lib",
    "package:publish": "./package.sh && cd package && npm publish",
    "release": "semantic-release"
  },
  "author": {
    "name": "Omar Dulaimi",
    "url": "https://github.com/omar-dulaimi"
  },
  "keywords": [
    "firestore",
    "firestore-prisma"
  ],
  "license": "MIT",
  "dependencies": {
    "@mrleebo/prisma-ast": "^0.5.1",
    "boxen": "^4.0.0",
    "chalk": "^4.1.0",
    "clear": "^0.1.0",
    "commander": "^9.4.1",
    "figlet": "^1.5.2",
    "ora": "^6.1.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/clear": "^0.1.2",
    "@types/figlet": "^1.5.5",
    "@types/node": "^17.0.35",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.8",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "^18.20.0 || >=20.10.0"
  },
  "bugs": {
    "url": "https://github.com/omar-dulaimi/firestore-prisma/issues"
  },
  "homepage": "https://github.com/omar-dulaimi/firestore-prisma#readme",
  "private": true
}
